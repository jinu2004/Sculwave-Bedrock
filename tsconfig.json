
{
  "compilerOptions": {
    // Target and Environment
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Official Type Declarations
    "types": [
      "@minecraft/server",
      "@minecraft/server-ui",
      "@minecraft/server-net"
    ],

    // File Organization
    "rootDir": "src",
    "outDir": "build",

    // Verification and Debugging
    "sourceMap": true,

    // Stricter Typechecking Options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "build"
  ]
}

